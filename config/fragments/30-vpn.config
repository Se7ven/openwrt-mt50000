# config/fragments/30-vpn.config
#
# VPN servers and clients.
#
# The GL.iNet stock firmware offers OpenVPN, WireGuard, AmneziaWG, Tailscale
# and ZeroTier. The packages that are not part of the OpenWrt feeds
# (AmneziaWG) can be added with an additional feed, see docs/BUILD.md.

CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-mbedtls=y
CONFIG_PACKAGE_kmod-ovpn-dco=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_wireguard-proto-bgp=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# the same packages under their old names (OpenWrt <= 24.10), the unknown ones
# are silently dropped by "make defconfig"
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_luci-app-wireguard=y
