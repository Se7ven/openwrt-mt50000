# config/fragments/10-network.config
#
# Network stack of the GL-MT5000.
#
# The MT5000 has three 2.5G ports:
#   * LAN 1 / LAN 2 - user ports of the Realtek RTL8366UB DSA switch
#                      (netdevs "lan1" and "lan2")
#   * WAN           - internal 2.5G PHY of the MediaTek MT7987A (netdev "eth1")
#
# The switch itself is handled by the kernel (DSA), no user space
# configuration is needed. The runtime configuration that reproduces the
# GL.iNet defaults is installed by the package "glinet-mt5000-defaults".

CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-nf-conntrack=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-crypto-hw-sha256=y
CONFIG_PACKAGE_kmod-crypto-hw-crypto=y
CONFIG_PACKAGE_kmod-lib-crypto-lib-aes=y
CONFIG_PACKAGE_kmod-lib-crypto-lib-ctr=y
CONFIG_PACKAGE_kmod-lib-crypto-lib-gcm=y
CONFIG_PACKAGE_kmod-lib-crypto-lib-chacha20poly1305=y

# hardware offloading (MediaTek PPE / HNAT)
CONFIG_PACKAGE_kmod-mediatek-hnat=y
CONFIG_PACKAGE_kmod-mediatek-hnat-ppe=y
