# config/fragments/40-luci.config
#
# Web interface of the GL-MT5000.
#
# The LuCI feed was restructured in 2025/2026: the applications that used to be
# called "luci-app-<x>" are now called "luci-mod-<x>" (system, network,
# status), "luci-proto-<x>" (openvpn, wireguard, ipv6) or
# "luci-app-<x>" (firewall, sqm, ...). Both spellings are listed here, the
# unknown ones are dropped by "make defconfig" with a warning.

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-chrony=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# names used by OpenWrt <= 24.10
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-ipv6=y
CONFIG_PACKAGE_luci-app-dhcp=y

# Russian translation
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-i18n-network-ru=y
CONFIG_PACKAGE_luci-i18n-system-ru=y
