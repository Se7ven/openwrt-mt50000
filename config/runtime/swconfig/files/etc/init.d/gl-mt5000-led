#!/bin/sh /etc/rc.common
#
# LED handling of the GL.iNet GL-MT5000 (Brume 3).
#
# The board has three LEDs:
#   * blue   "run"     - power LED, always on (DTS default-state = on)
#   * white  "system"  - on as soon as the system is up
#   * white  "vpn"     - controlled by the VPN client, off by default
#
START=11
STOP=89

start() {
	# the white "system" LED is not enabled by the device tree, switch it on
	local led
	for led in /sys/class/leds/*:system /sys/class/leds/system*; do
		[ -e "${led}/brightness" ] || continue
		echo 1 > "${led}/brightness" 2>/dev/null
	done

	# the blue "run" LED has to be on in any case
	for led in /sys/class/leds/*:run /sys/class/leds/run*; do
		[ -e "${led}/brightness" ] || continue
		echo 1 > "${led}/brightness" 2>/dev/null
	done
}

stop() {
	local led
	for led in /sys/class/leds/*:system /sys/class/leds/system*; do
		[ -e "${led}/brightness" ] || continue
		echo 0 > "${led}/brightness" 2>/dev/null
	done
}
