#!/bin/sh
#
# GL.iNet runtime defaults for the GL-MT5000 (Brume 3).
#
# The values below reproduce the defaults of the GL.iNet stock firmware
# (firmware 4.9.0) as closely as possible:
#
#   * router IP        192.168.8.1/24
#   * DHCP pool        192.168.8.100 - 192.168.8.249
#   * hostname         GL-MT5000
#   * WAN              DHCP client, IPv6 disabled by default
#   * "console.gl-inet.com" resolves to the router IP (IPv4 and IPv4-mapped IPv6)
#   * WAN firewall zone: input DROP, no ICMP echo from the internet
#
# The script is idempotent, it can be re-run at any time.
#
. /lib/functions.sh
. /lib/functions/uci-defaults.sh

ROUTER_IP="192.168.8.1"
ROUTER_NETMASK="255.255.255.0"

# ---------------------------------------------------------------------------
# system
# ---------------------------------------------------------------------------
uci -q batch <<-EOF
	set system.@system[0].hostname='GL-MT5000'
	set system.@system[0].timezone='UTC'
	set system.@system[0].zonename='UTC'
	set system.@system[0].ttylogin='1'
	commit system
EOF

# ---------------------------------------------------------------------------
# network
# ---------------------------------------------------------------------------
# LAN: static address in the GL.iNet 192.168.8.0/24 range
if [ -n "$(uci -q get network.lan)" ]; then
	uci -q batch <<-EOF
		set network.lan.proto='static'
		set network.lan.ipaddr='${ROUTER_IP}'
		set network.lan.netmask='${ROUTER_NETMASK}'
		commit network
	EOF
fi

# WAN: DHCP client, IPv6 off (GL.iNet default, can be switched on in the UI)
if [ -n "$(uci -q get network.wan)" ]; then
	uci -q batch <<-EOF
		set network.wan.proto='dhcp'
		set network.wan.ipv6='0'
		commit network
	EOF
fi

# the IPv6 WAN interface stays disabled until it is enabled explicitly
if [ -n "$(uci -q get network.wan6)" ]; then
	uci -q set network.wan6.disabled='1'
	uci -q commit network
fi

# ---------------------------------------------------------------------------
# DHCP / dnsmasq
# ---------------------------------------------------------------------------
# the DHCP server of the LAN interface: 192.168.8.100-249, 12h lease time
set_dhcp_lan() {
	local cfg="$1"
	local iface
	config_get iface "${cfg}" interface
	[ "${iface}" = "lan" ] || return 0
	uci -q set dhcp."${cfg}".start='100'
	uci -q set dhcp."${cfg}".limit='150'
	uci -q set dhcp."${cfg}".leasetime='12h'
}

config_load dhcp
config_foreach set_dhcp_lan dhcp

uci -q batch <<-EOF
	set dhcp.@dnsmasq[0].rebind_protection='0'
	set dhcp.@dnsmasq[0].domain='lan'
	set dhcp.@dnsmasq[0].localise_queries='1'
	set dhcp.@dnsmasq[0].local='/lan/'
	commit dhcp
EOF

# "console.gl-inet.com" -> router IP (the GL.iNet cloud console)
has_console_domain() {
	local cfg="$1"
	local name
	config_get name "${cfg}" name
	[ "${name}" = "console.gl-inet.com" ]
}

config_load dhcp
if ! config_foreach has_console_domain domain; then
	uci -q batch <<-EOF
		add dhcp domain
		set dhcp.@[-1].name='console.gl-inet.com'
		set dhcp.@[-1].ip='${ROUTER_IP}'
		add dhcp domain
		set dhcp.@[-1].name='console.gl-inet.com'
		set dhcp.@[-1].ip='::ffff:${ROUTER_IP}'
		commit dhcp
	EOF
fi

# ---------------------------------------------------------------------------
# firewall
# ---------------------------------------------------------------------------
# GL.iNet uses "input DROP" for the WAN zone and removes the ICMP echo rule
set_wan_zone() {
	local cfg="$1"
	local name
	config_get name "${cfg}" name
	[ "${name}" = "wan" ] && uci -q set firewall."${cfg}".input='DROP'
}

delete_ping_rule() {
	local cfg="$1"
	local name
	config_get name "${cfg}" name
	[ "${name}" = "Allow-Ping" ] && uci -q delete firewall."${cfg}"
}

config_load firewall
config_foreach set_wan_zone zone
config_foreach delete_ping_rule rule
uci -q commit firewall

exit 0
